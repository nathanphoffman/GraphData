# Copy to .env (which git ignores) to use your own login locally. Without it, local dev uses admin / admin.
ADMIN_USERNAME=your-username
ADMIN_PASSWORD=your-password

# Used by `just sync-prod` to copy your local rankings and weigh-ins to the live site.
# These are the live site's login (its ADMIN_USERNAME / ADMIN_PASSWORD), not your local one.
PROD_URL=https://your-site.example
PROD_USERNAME=your-live-username
PROD_PASSWORD=your-live-password
