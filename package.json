{
  "name": "graphdata",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "data": "python3 scripts/build-language-data.py",
    "start": "sirv dist --host 0.0.0.0 --port ${PORT:-3000} --single",
    "test": "vitest run",
    "lint": "biome lint src"
  },
  "dependencies": {
    "d3-scale": "^4.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "sirv-cli": "^3.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/d3-scale": "^4.0.8",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.6.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12"
  }
}
